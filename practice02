#include <iostream>
#include <string>
#include <vector>
#include <algorithm>
using namespace std;

class Employee {
protected:
    string cccd, sdt, address;

public:
    Employee() {
        cccd = "";
        sdt = "";
        address = "";
    }

    Employee(string c, string s, string a) {
        cccd = c;
        sdt = s;
        address = a;
    }

    virtual ~Employee() {}

    string getCCCD() const { return cccd; }
    string getSDT() const { return sdt; }
    string getAddress() const { return address; }

    void setCCCD(string c) { cccd = c; }
    void setSDT(string s) { sdt = s; }
    void setAddress(string a) { address = a; }

    virtual double tinhLuong() const {
        return 0;
    }

    virtual void displayInfo() const {
        cout << "CCCD: " << cccd << endl;
        cout << "SDT: " << sdt << endl;
        cout << "Address: " << address << endl;
    }
};

class HourlyEmployee : public Employee {
private:
    int soGioLamViec;
    double donGia;

public:
    HourlyEmployee() : Employee() {
        soGioLamViec = 0;
        donGia = 0;
    }

    HourlyEmployee(string c, string s, string a, int gio, double gia)
        : Employee(c, s, a) {
        soGioLamViec = gio;
        donGia = gia;
    }

    int getSoGioLamViec() const { return soGioLamViec; }
    double getDonGia() const { return donGia; }

    void setSoGioLamViec(int gio) { soGioLamViec = gio; }
    void setDonGia(double gia) { donGia = gia; }

    double tinhLuong() const override {
        return soGioLamViec * donGia;
    }

    void displayInfo() const override {
        Employee::displayInfo();
        cout << "So gio lam: " << soGioLamViec << endl;
        cout << "Don gia: " << donGia << endl;
        cout << "Luong: " << tinhLuong() << endl;
    }
};

class MonthlyEmployee : public Employee {
private:
    double luongCoBan, phuCap, heSoThuong;

public:
    MonthlyEmployee() : Employee() {
        luongCoBan = 0;
        phuCap = 0;
        heSoThuong = 0;
    }

    MonthlyEmployee(string c, string s, string a,
                    double lcb, double pc, double hs)
        : Employee(c, s, a) {
        luongCoBan = lcb;
        phuCap = pc;
        heSoThuong = hs;
    }

    double getLuongCoBan() const { return luongCoBan; }
    double getPhuCap() const { return phuCap; }
    double getHeSoThuong() const { return heSoThuong; }

    void setLuongCoBan(double lcb) { luongCoBan = lcb; }
    void setPhuCap(double pc) { phuCap = pc; }
    void setHeSoThuong(double hs) { heSoThuong = hs; }

    double tinhLuong() const override {
        return luongCoBan + phuCap + luongCoBan * heSoThuong;
    }

    void displayInfo() const override {
        Employee::displayInfo();
        cout << "Luong co ban: " << luongCoBan << endl;
        cout << "Phu cap: " << phuCap << endl;
        cout << "He so thuong: " << heSoThuong << endl;
        cout << "Luong: " << tinhLuong() << endl;
    }
};

void hienThiDanhSach(const vector<Employee*>& ds) {
    for (int i = 0; i < (int)ds.size(); i++) {
        cout << "\nNhan vien " << i + 1 << endl;
        ds[i]->displayInfo();
        cout << "------------------" << endl;
    }
}

double tinhTongLuong(const vector<Employee*>& ds) {
    double tong = 0;

    for (Employee* nv : ds)
        tong += nv->tinhLuong();

    return tong;
}

void timLuongCaoThap(const vector<Employee*>& ds) {
    if (ds.empty()) return;

    Employee* cao = ds[0];
    Employee* thap = ds[0];

    for (Employee* nv : ds) {
        if (nv->tinhLuong() > cao->tinhLuong())
            cao = nv;

        if (nv->tinhLuong() < thap->tinhLuong())
            thap = nv;
    }

    cout << "\nNhan vien luong cao nhat:\n";
    cao->displayInfo();

    cout << "\nNhan vien luong thap nhat:\n";
    thap->displayInfo();
}

void demNhanVien(const vector<Employee*>& ds) {
    int soGio = 0, soThang = 0;

    for (Employee* nv : ds) {
        if (dynamic_cast<HourlyEmployee*>(nv))
            soGio++;
        else if (dynamic_cast<MonthlyEmployee*>(nv))
            soThang++;
    }

    cout << "Nhan vien theo gio: " << soGio << endl;
    cout << "Nhan vien theo thang: " << soThang << endl;
}

void timTheoLuong(const vector<Employee*>& ds, double mucLuong) {
    bool timThay = false;

    for (Employee* nv : ds) {
        if (nv->tinhLuong() > mucLuong) {
            nv->displayInfo();
            timThay = true;
        }
    }

    if (!timThay)
        cout << "Khong tim thay nhan vien phu hop." << endl;
}

void sapXepLuong(vector<Employee*>& ds) {
    sort(ds.begin(), ds.end(),
        [](Employee* a, Employee* b) {
            return a->tinhLuong() > b->tinhLuong();
        });
}

int main() {
    vector<Employee*> ds;

    ds.push_back(new HourlyEmployee(
        "001", "0901111222", "Can Tho", 160, 50000));

    ds.push_back(new HourlyEmployee(
        "002", "0903333444", "Da Nang", 120, 60000));

    ds.push_back(new MonthlyEmployee(
        "003", "0911111222", "Ha Noi", 15000000, 2000000, 0.2));

    ds.push_back(new MonthlyEmployee(
        "004", "0913333444", "Hue", 12000000, 1500000, 0.1));

    cout << "=== DANH SACH NHAN VIEN ===" << endl;
    hienThiDanhSach(ds);

    cout << "\nTong quy luong: "
         << tinhTongLuong(ds) << endl;

    cout << "\n=== LUONG CAO NHAT VA THAP NHAT ===" << endl;
    timLuongCaoThap(ds);

    cout << "\n=== THONG KE NHAN VIEN ===" << endl;
    demNhanVien(ds);

    double mucLuong;
    cout << "\nNhap muc luong can tim: ";
    cin >> mucLuong;

    cout << "\n=== NHAN VIEN CO LUONG CAO HON MUC NHAP ===" << endl;
    timTheoLuong(ds, mucLuong);

    sapXepLuong(ds);

    cout << "\n=== DANH SACH SAU KHI SAP XEP ===" << endl;
    hienThiDanhSach(ds);

    for (Employee* nv : ds)
        delete nv;

    return 0;
}
